#!/bin/sh
# Clickra pre-push hook (versioned in-repo).
# Installed once per clone with:  git config core.hooksPath scripts/hooks
# (or run scripts/install-hooks.sh).
#
# Mirrors .github/workflows/ci.yml: really builds every product project and
# runs the self-built test runner with the correct invocation. It replaces the
# old local-only hook that ran `dotnet test` on an Exe project, which built
# successfully without executing a single test.
#
# Notes:
# - The runner exits non-zero when any test fails, so a push is aborted just
#   like the CI test job would be. test_pdfs/ is git-ignored, so on a fresh
#   clone the fixture-dependent layout tests print SKIP instead of FAIL (same
#   behavior as CI). With fixtures present locally the suite still has a known
#   baseline tracked as PR-B in docs/development/PR46_POST_MERGE_AUDIT_AND_OPTIONS.md.
# - Never bypass required checks with git push --no-verify. A failed gate must
#   be repaired or explicitly handled through the project's exception process.
# - Real-document PDF fixtures are supplementary unless translation code or
#   regression coverage changes; those changes require the fixture suite.

set -e

echo "[pre-push] Checking latest remote main, branch ancestry and commit policy..."
# Git supplies one line per pushed ref on stdin. A tag-only release is outside
# PR publication; do not reject it merely because HEAD is main/detached.
# Git invokes pre-push with remote-name and remote-url arguments; pr_tool ready
# invokes this hook directly with no arguments and must not consume stdin.
if [ "$#" -ge 2 ]; then
  push_updates=$(cat)
else
  push_updates=""
fi
push_args=""
initial_push_flag=""
if [ -n "$push_updates" ]; then
  branch_count=0
  tag_count=0
  while read -r local_ref local_oid remote_ref remote_oid; do
    if [ -z "$local_oid" ] || [ -z "$remote_ref" ] || [ -z "$remote_oid" ]; then
      echo "[pre-push] ERROR: incomplete pushed ref update." >&2
      exit 1
    fi
    if [ "$local_ref" != "$remote_ref" ]; then
      echo "[pre-push] ERROR: pushed destination must match source ref: $local_ref -> $remote_ref" >&2
      exit 1
    fi
    case "$local_ref" in
      refs/tags/*)
        if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
          echo "[pre-push] ERROR: tag deletion requires a separate release operation." >&2
          exit 1
        fi
        tag_count=$((tag_count + 1))
        ;;
      refs/heads/*)
        case "$remote_ref" in
          refs/heads/main|refs/heads/master)
            echo "[pre-push] ERROR: pushing directly to main/master is prohibited." >&2
            exit 1 ;;
        esac
        if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
          echo "[pre-push] ERROR: branch deletion requires separate authorization." >&2
          exit 1
        fi
        branch_count=$((branch_count + 1))
        push_args="$local_ref $local_oid"
        if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
          initial_push_flag="--initial-push"
        fi
        ;;
      *) echo "[pre-push] ERROR: unsupported pushed ref: $local_ref" >&2; exit 1 ;;
    esac
  done <<EOF
$push_updates
EOF
  if [ "$branch_count" -gt 0 ] && [ "$tag_count" -gt 0 ]; then
    echo "[pre-push] ERROR: push tags and development branches in separate operations." >&2
    exit 1
  fi
  if [ "$branch_count" -eq 0 ]; then
    echo "[pre-push] Tag-only push: PR checks are inapplicable; release/tag authorization and gates are handled separately."
    exit 0
  fi
  if [ "$branch_count" -ne 1 ]; then
    echo "[pre-push] ERROR: push one development branch at a time." >&2
    exit 1
  fi
elif [ "$#" -ge 2 ]; then
  echo "[pre-push] ERROR: Git provided no pushed ref updates; cannot verify destination." >&2
  exit 1
fi
if [ -z "${CLICKRA_PR_BODY_FILE:-}" ]; then
  echo "[pre-push] ERROR: set CLICKRA_PR_BODY_FILE to the finalized PR body draft path." >&2
  exit 1
fi
if [ -n "$push_args" ]; then
  set -- $push_args
  python scripts/pr_preflight.py --check --body-file "$CLICKRA_PR_BODY_FILE" --push-ref "$1" --push-oid "$2" $initial_push_flag
else
  python scripts/pr_preflight.py --check --body-file "$CLICKRA_PR_BODY_FILE"
fi

echo "[pre-push] Running PR governance script tests..."
python -m unittest discover -s tests -p 'test_pr_preflight.py' -v
python -m unittest discover -s tests -p 'test_gh_guard.py' -v
python -m unittest discover -s tests -p 'test_pr_tool.py' -v
python -m unittest discover -s tests -p 'test_branch_policy.py' -v
python -m unittest discover -s tests -p 'test_pr_reports.py' -v
python -m unittest discover -s tests -p 'test_pr_publication.py' -v
python -m unittest discover -s tests -p 'test_pr_creation.py' -v
python -m unittest discover -s tests -p 'test_pr_verification.py' -v

echo "Running pre-push checks (mirrors .github/workflows/ci.yml)..."

echo "[pre-push] Building Clickra.Core (warnaserror)..."
dotnet build src/Clickra.Core/Clickra.Core.csproj -c Release -warnaserror

echo "[pre-push] Building Clickra.CLI (warnaserror)..."
dotnet build src/Clickra.CLI/Clickra.csproj -c Release -warnaserror

echo "[pre-push] Building ClickraShell (warnaserror)..."
dotnet build src/ClickraShell/ClickraShell.csproj -c Release -warnaserror

echo "[pre-push] Building ClickraLauncher (warnaserror)..."
dotnet build src/ClickraLauncher/ClickraLauncher.csproj -c Release -warnaserror

echo "[pre-push] Building Clickra.Fluent (warnaserror)..."
dotnet build src/Clickra.Fluent/Clickra.Fluent.csproj -c Release -warnaserror

echo "[pre-push] Verifying product icon assets..."
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify_icon_assets.ps1
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File scripts/verify_icon_assets.ps1
else
  echo "[pre-push] ERROR: PowerShell (powershell.exe or pwsh) is required for icon verification." >&2
  exit 1
fi


echo "[pre-push] Running architecture and localization guards (warnaserror)..."
dotnet run --project tests/Clickra.Core.Tests/Clickra.Core.Tests.csproj -c Release --property:TreatWarningsAsErrors=true -- --guards

echo "[pre-push] Running functional unit tests (warnaserror)..."
dotnet run --project tests/Clickra.Core.Tests/Clickra.Core.Tests.csproj -c Release --property:TreatWarningsAsErrors=true -- --functional

echo "[pre-push] Running Store publishing unit tests..."
python -m unittest discover -s tests -p 'test_*store*.py' -v

# NativeAOT is a required release-path gate, not an optional follow-up.
echo "[pre-push] Publishing all three NativeAOT products (warnings as errors)..."
dotnet publish src/Clickra.CLI/Clickra.csproj -c Release -r win-x64 --self-contained true -o publish/pre-push/cli -warnaserror
dotnet publish src/ClickraShell/ClickraShell.csproj -c Release -r win-x64 --self-contained true -o publish/pre-push/shell -warnaserror
dotnet publish src/ClickraLauncher/ClickraLauncher.csproj -c Release -r win-x64 --self-contained true -o publish/pre-push/launcher -warnaserror

if python scripts/pdf_fixture_scope.py --base origin/main; then
  if [ ! -d test_pdfs/source ]; then
    echo "[pre-push] ERROR: translation changes require real PDF fixtures; test_pdfs/source unavailable." >&2
    exit 1
  fi
  echo "[pre-push] Running required translation fixture regressions..."
  dotnet run --project tests/Clickra.Core.Tests/Clickra.Core.Tests.csproj -c Release --property:TreatWarningsAsErrors=true -- --require-fixtures
else
  result=$?
  if [ "$result" -ne 1 ]; then
    echo "[pre-push] ERROR: cannot determine PDF fixture requirement." >&2
    exit "$result"
  fi
  echo "[pre-push] Real PDF fixture regressions supplementary for this change."
fi

echo "All pre-push PR checks passed."
# Remote main can advance during long builds and NativeAOT publishing.
if [ -n "$push_args" ]; then
  set -- $push_args
  python scripts/pr_preflight.py --check --body-file "$CLICKRA_PR_BODY_FILE" --push-ref "$1" --push-oid "$2" $initial_push_flag
else
  python scripts/pr_preflight.py --check --body-file "$CLICKRA_PR_BODY_FILE"
fi
