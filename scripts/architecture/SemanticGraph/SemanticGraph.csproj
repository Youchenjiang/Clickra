<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CompilerDir>$(MSBuildSDKsPath)\..\Roslyn\bincore</CompilerDir>
    <ToolDir>$(MSBuildSDKsPath)\..\DotnetTools\dotnet-format</ToolDir>
    <BuildHostDir>$(ToolDir)\BuildHost-netcore</BuildHostDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(CompilerDir)\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(CompilerDir)\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>$(ToolDir)\Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
      <HintPath>$(ToolDir)\Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild">
      <HintPath>$(ToolDir)\Microsoft.CodeAnalysis.Workspaces.MSBuild.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Locator">
      <HintPath>$(BuildHostDir)\Microsoft.Build.Locator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.AttributedModel">
      <HintPath>$(ToolDir)\System.Composition.AttributedModel.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Convention">
      <HintPath>$(ToolDir)\System.Composition.Convention.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Hosting">
      <HintPath>$(ToolDir)\System.Composition.Hosting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.Runtime">
      <HintPath>$(ToolDir)\System.Composition.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Composition.TypedParts">
      <HintPath>$(ToolDir)\System.Composition.TypedParts.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(BuildHostDir)\**\*.*">
      <Link>BuildHost-netcore\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
