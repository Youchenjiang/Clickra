<Project>
  <Target Name="EnsureClickraIcons" BeforeTargets="BeforeBuild" Condition="'$(MSBuildProjectName)' != 'IconGen' and '$(ClickraSkipIconGen)' != 'true' and $([MSBuild]::IsOSPlatform('windows')) and !Exists('$(MSBuildThisFileDirectory)obj\icons\app.ico')">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)scripts\tools\IconGen\IconGen.csproj&quot;"
          StandardOutputImportance="Low" />
  </Target>
</Project>
