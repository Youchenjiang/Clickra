<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Clickra.Desktop.App"
             RequestedThemeVariant="Light">
    <!-- Default appearance is light; users switch to dark in Settings (decision log 2026-11-14). -->
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#005FB8" />
                <ColorPaletteResources x:Key="Dark" Accent="#60CDFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Clickra.Desktop/Styles/Controls.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Clickra.Desktop/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
