<!-- Main window: up to 960 x 660, shrunk to fit small screens at first launch; 760 x 520 minimum (spec section 2).
     Top row = brand + three tabs; it extends into the system title bar where the OS allows (section 3.1). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Clickra.Desktop.ViewModels"
        xmlns:pages="using:Clickra.Desktop.Views.Pages"
        x:Class="Clickra.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Clickra"
        Icon="avares://Clickra.Desktop/Assets/clickra-64.png"
        Width="960" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="avares://Clickra.Desktop/Assets/Fonts#Noto Sans TC, Microsoft JhengHei UI, PingFang TC, Noto Sans CJK TC, $Default"
        FontSize="14">

    <Grid RowDefinitions="Auto,*">

        <!-- Top row: brand, tabs, then an empty drag area up to the system caption buttons. -->
        <Grid Name="TopBar" Grid.Row="0" MinHeight="48" ColumnDefinitions="Auto,Auto,*">
            <StackPanel Name="BrandPanel" Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                <Image Source="avares://Clickra.Desktop/Assets/clickra-64.png" Width="20" Height="20" />
                <TextBlock Text="Clickra" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,16,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Stretch">
                <RadioButton Classes="tab" GroupName="MainTabs"
                             Content="{Binding ConvertTabLabel}"
                             IsChecked="{Binding IsConvertPage}" />
                <RadioButton Classes="tab" GroupName="MainTabs"
                             Content="{Binding HistoryTabLabel}"
                             IsChecked="{Binding IsHistoryPage}" />
                <RadioButton Classes="tab" GroupName="MainTabs"
                             Content="{Binding SettingsTabLabel}"
                             IsChecked="{Binding IsSettingsPage}" />
            </StackPanel>

            <Border Grid.Column="2" Background="Transparent" IsHitTestVisible="False" />
        </Grid>

        <!-- Page area: content column is at most 860 wide and centered (section 6). -->
        <Panel Grid.Row="1" Margin="24,4,24,0">
            <Panel MaxWidth="{StaticResource Clk.ContentMaxWidth}">
                <pages:ConvertPage Name="ConvertView" IsVisible="{Binding IsConvertPage}" />
                <pages:HistoryPage Name="HistoryView" IsVisible="{Binding IsHistoryPage}" />
                <pages:SettingsPage Name="SettingsView" IsVisible="{Binding IsSettingsPage}" />
            </Panel>
        </Panel>
    </Grid>
</Window>
