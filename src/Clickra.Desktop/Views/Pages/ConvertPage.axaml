<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Clickra.Desktop.ViewModels"
             xmlns:controls="using:Clickra.Desktop.Controls"
             xmlns:rows="using:Clickra.Desktop.Views.Controls"
             x:Class="Clickra.Desktop.Views.Pages.ConvertPage"
             x:DataType="vm:ConvertViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <Style Selector="Border.menuItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Border.menuItem > TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
        </Style>
        <Style Selector="Border.fileNarrowRow">
            <Setter Property="Background" Value="{DynamicResource Clk.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Border.catalogPlate">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource Clk.IconPlate}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Clk.IconPlateBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.catalogCard">
            <Setter Property="Background" Value="{DynamicResource Clk.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="130" />
        </Style>
        <!-- Card contents (normal size: icon 52 on a 68 plate, name 20; spec 4.1). -->
        <Style Selector="StackPanel.cardStack">
            <Setter Property="Spacing" Value="10" />
        </Style>
        <Style Selector="Image.cardIcon">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
        </Style>
        <Style Selector="TextBlock.cardName">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <!-- Compact: used only when two rows of normal cards do not fit the height (small screens or high
             display scaling, where the window opens below 660). Set in code-behind (FitCatalog). -->
        <Style Selector="ItemsControl.compact Button.catalogCard">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ItemsControl.compact StackPanel.cardStack">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="ItemsControl.compact Border.catalogPlate">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="15" />
        </Style>
        <Style Selector="ItemsControl.compact Image.cardIcon">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style Selector="ItemsControl.compact TextBlock.cardName">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.catalogCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Clk.CardHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
        </Style>
    </UserControl.Styles>

    <Grid Name="PageGrid" Margin="0,0,0,24">
        <Grid.RowDefinitions>
            <!-- Top Area: Drop Zone (State A) or File Narrow Row (State B-F) -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Bottom Area: Section containing catalog, action page, progress, or results -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP AREA ==================== -->
        <!-- State A: Drop zone -->
        <!-- With no files the drop zone fills what 最近處理 leaves (at least 240); rows are switched in code-behind.
             TopArea holds both top states so the collapse animation (spec 4.1) can shrink one box down to 72. -->
        <Panel Grid.Row="0" Name="TopArea" ClipToBounds="True" VerticalAlignment="Top">
            <Panel Name="DropZone" IsVisible="{Binding IsDropZone}" VerticalAlignment="Stretch">
                <Border Background="{DynamicResource Clk.Card}" CornerRadius="16" />
                <Rectangle Stroke="{DynamicResource Clk.ControlBorder}" StrokeThickness="1"
                           StrokeDashArray="4,3" RadiusX="16" RadiusY="16" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center"
                            Background="{DynamicResource Clk.Surface}">
                        <Viewbox Classes="ic" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19"
                                      Stroke="{DynamicResource Clk.Accent}"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Classes="h1" FontSize="26" Text="要處理什麼檔案？" HorizontalAlignment="Center" />
                    <TextBlock Classes="secondary" FontSize="15" Text="把檔案拖到這裡，Clickra 會告訴你可以做什麼。"
                               HorizontalAlignment="Center" />
                    <Button Classes="primary" Name="PickFilesButton" Content="選擇檔案" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Panel>

            <!-- State B-F: File summary narrow row (Height 72 DIP) -->
            <Border Name="FileNarrowRow" Classes="fileNarrowRow" IsVisible="{Binding HasFiles}" VerticalAlignment="Top">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- File domain icon plate -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                            Background="{Binding PrimaryDomainColor}" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <Viewbox Classes="ic" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6,2 H14 L18,6 V22 H6 Z M14,2 V6 H18"
                                      Stroke="#FFFFFF"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- File Summary Texts -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding FileSummaryHeader}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FileSummarySubtext}" Classes="secondary" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="500" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- Actions: Manage Files and Re-pick -->
                    <Button Grid.Column="2" Classes="secondary" Name="ManageFilesButton"
                            Content="管理檔案" Margin="0,0,8,0" VerticalAlignment="Center"
                            IsEnabled="{Binding !IsExecuting}" />
                    <Button Grid.Column="3" Classes="subtle" Name="RePickFilesButton"
                            Content="重新選" VerticalAlignment="Center"
                            IsEnabled="{Binding !IsExecuting}" />
                </Grid>
            </Border>

        </Panel>

        <!-- ==================== BOTTOM AREA ==================== -->
        <Border Grid.Row="2" Name="BottomSection" Classes="section">
            <Panel>

                <!-- STATE A: No files yet -->
                <Panel Name="StartBottom" IsVisible="{Binding IsDropZone}">
                    <!-- A1: 最近處理, the same rows and buttons as History (spec 4.1). The section hugs its rows
                         (at most 3); rows that do not fit are left out, never cut (spec 5.2). -->
                    <Grid IsVisible="{Binding HasRecentHistory}" RowDefinitions="Auto,*" VerticalAlignment="Top">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,-6,0,6">
                            <TextBlock Grid.Column="0" Text="最近處理" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="link" Name="ViewAllHistoryButton" Content="全部歷史 ›" FontSize="13" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentItems}" Margin="-20,0,-20,-14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:FitStackPanel Spacing="0" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                    <rows:HistoryRowView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- A2: First-time hint if no history -->
                    <StackPanel IsVisible="{Binding !HasRecentHistory}" Orientation="Horizontal" Spacing="22"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="132" Padding="6" CornerRadius="8" VerticalAlignment="Center"
                                Background="{DynamicResource Clk.Card}"
                                BorderBrush="{DynamicResource Clk.ControlBorder}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <Border Classes="menuItem"><TextBlock Text="開啟" /></Border>
                                <Border Classes="menuItem"><TextBlock Text="複製" /></Border>
                                <Border Classes="menuItem" Background="{DynamicResource Clk.SegmentSelected}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Image Source="avares://Clickra.Desktop/Assets/clickra-64.png" Width="14" Height="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="Clickra" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="›" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="menuItem"><TextBlock Text="內容" /></Border>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4" MaxWidth="420">
                            <TextBlock Text="也可以在檔案總管直接使用" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" FontSize="14" TextWrapping="Wrap"
                                       Text="對檔案按右鍵，選 Clickra，就能不開這個視窗直接處理" />
                            <Button Classes="link" Name="MenuSettingsLink" Content="選擇右鍵選單要顯示的功能"
                                    HorizontalAlignment="Left" FontSize="14" />
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <!-- STATE B1: Action Catalog (Grid of available actions) -->
                <Grid Name="CatalogPanel" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsActionCatalog}">
                    <TextBlock Grid.Row="0" Text="要對這些檔案做什麼？" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <ScrollViewer Grid.Row="2" Name="CatalogScroll">
                        <!-- Top-aligned: cards keep their own height instead of being stretched to fill the viewport,
                             which made the content exactly as tall as the view and showed a scroll bar from rounding. -->
                        <ItemsControl Name="CatalogItems" ItemsSource="{Binding AvailableActions}" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="catalogCard" Margin="6" Tag="{Binding}"
                                            ToolTip.Tip="{Binding ToolTip}"
                                            Command="{Binding $parent[UserControl].((vm:ConvertViewModel)DataContext).SelectAction}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Classes="cardStack" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Classes="catalogPlate" HorizontalAlignment="Center">
                                                <!-- Official feature icon (assets/features, same as the context menu), 52 on a 68 plate (spec 4.1). -->
                                                <Image Classes="cardIcon" Source="{Binding Icon}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Classes="cardName" Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- STATE B2: Action Page (Options and Start) -->
                <Grid Name="ActionPagePanel" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsActionPage}">
                    <!-- Title Row: Back button + Icon + Name -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
                        <Button Grid.Column="0" Classes="link" Name="BackToCatalogButton"
                                Content="‹ 所有動作" FontSize="15" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <!-- The feature icon is its own coloured tile, so it gets no extra plate (spec 7). -->
                        <Image Grid.Column="1" Name="ActionIcon" Width="32" Height="32" Margin="0,0,10,0"
                               VerticalAlignment="Center" Source="{Binding SelectedAction.Icon}" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedAction.FullFeatureName}"
                                   FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 批次重新命名: full workspace, rules left and live preview right (spec 4.6). -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsRenameAction}" ColumnDefinitions="300,16,*">
                        <ScrollViewer Grid.Column="0">
                            <StackPanel Spacing="8" Margin="0,0,8,0">
                                <CheckBox Content="取代文字" IsChecked="{Binding Rename.UseReplace}" />
                                <Grid IsVisible="{Binding Rename.UseReplace}" ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="6" Margin="28,0,0,6">
                                    <TextBlock Text="尋找" VerticalAlignment="Center" Classes="secondary" />
                                    <TextBox Grid.Column="1" Text="{Binding Rename.FindText}" />
                                    <TextBlock Grid.Row="1" Text="改成" VerticalAlignment="Center" Classes="secondary" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Rename.ReplaceWith}" />
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <CheckBox Content="區分大小寫" IsChecked="{Binding Rename.MatchCase}" />
                                        <CheckBox Content="使用正規表示式" IsChecked="{Binding Rename.UseRegex}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="加上編號" IsChecked="{Binding Rename.UseNumbering}" />
                                <Grid IsVisible="{Binding Rename.UseNumbering}" ColumnDefinitions="56,*" RowDefinitions="Auto,Auto"
                                      RowSpacing="6" Margin="28,0,0,6">
                                    <TextBlock Text="起始" VerticalAlignment="Center" Classes="secondary" />
                                    <TextBox Grid.Column="1" Text="{Binding Rename.StartNumber}" Width="80" HorizontalAlignment="Left"
                                             ToolTip.Tip="寫 01 就是兩位數，寫 001 就是三位數" />
                                    <TextBlock Grid.Row="1" Text="位置" VerticalAlignment="Center" Classes="secondary" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding Rename.NumberPosition, Mode=TwoWay}">
                                        <ComboBoxItem Content="檔名前面" />
                                        <ComboBoxItem Content="檔名後面" />
                                    </ComboBox>
                                </Grid>

                                <CheckBox Content="加上日期" IsChecked="{Binding Rename.UseDate}" />
                                <Grid IsVisible="{Binding Rename.UseDate}" ColumnDefinitions="56,*" RowDefinitions="Auto,Auto"
                                      RowSpacing="6" Margin="28,0,0,6">
                                    <TextBlock Text="日期" VerticalAlignment="Center" Classes="secondary" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Rename.DateSource, Mode=TwoWay}">
                                        <ComboBoxItem Content="修改日期" />
                                        <ComboBoxItem Content="建立日期" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="位置" VerticalAlignment="Center" Classes="secondary" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding Rename.DatePosition, Mode=TwoWay}">
                                        <ComboBoxItem Content="檔名前面" />
                                        <ComboBoxItem Content="檔名後面" />
                                    </ComboBox>
                                </Grid>

                                <CheckBox Content="加上前後文字" IsChecked="{Binding Rename.UseAffix}" />
                                <Grid IsVisible="{Binding Rename.UseAffix}" ColumnDefinitions="56,*" RowDefinitions="Auto,Auto"
                                      RowSpacing="6" Margin="28,0,0,6">
                                    <TextBlock Text="前面" VerticalAlignment="Center" Classes="secondary" />
                                    <TextBox Grid.Column="1" Text="{Binding Rename.Prefix}" />
                                    <TextBlock Grid.Row="1" Text="後面" VerticalAlignment="Center" Classes="secondary" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Rename.Suffix}" />
                                </Grid>

                                <!-- Case and extension apply to every name, so they are always shown (D2: no 進階選項). -->
                                <Border Classes="divider" Margin="0,4" />
                                <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Text="大小寫" VerticalAlignment="Center" Classes="secondary" />
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Rename.CaseIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="不變" />
                                        <ComboBoxItem Content="全部小寫" />
                                        <ComboBoxItem Content="全部大寫" />
                                        <ComboBoxItem Content="每個字首大寫" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="副檔名" VerticalAlignment="Center" Classes="secondary" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding Rename.ExtensionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="保持原樣" />
                                        <ComboBoxItem Content="小寫" />
                                        <ComboBoxItem Content="大寫" />
                                        <ComboBoxItem Content="改成…" />
                                    </ComboBox>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Rename.CustomExtension}"
                                             IsVisible="{Binding Rename.IsCustomExtension}" PlaceholderText="例如 jpg" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Column="2" Classes="card" Padding="0">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="14,10">
                                    <TextBlock Text="預覽" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rename.PreviewSummary}" FontSize="13"
                                               Classes="secondary" IsVisible="{Binding !Rename.HasProblems}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Rename.PreviewSummary}" FontSize="13"
                                               Foreground="{DynamicResource Clk.Danger}" IsVisible="{Binding Rename.HasProblems}" />
                                </Grid>
                                <!-- The only part that scrolls (spec 4.6). -->
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding Rename.Preview}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RenamePreviewRow">
                                                <Border BorderBrush="{DynamicResource Clk.Divider}" BorderThickness="0,1,0,0" Padding="14,7">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding OldName}" FontSize="13" Classes="secondary"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="→" FontSize="13" Classes="secondary" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding NewName}" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       IsVisible="{Binding !IsUnchanged}" />
                                                            <TextBlock Grid.Column="2" Text="不變" FontSize="13" Classes="secondary"
                                                                       VerticalAlignment="Center" IsVisible="{Binding IsUnchanged}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Problem}" FontSize="12" IsVisible="{Binding IsProblem}"
                                                                   Foreground="{DynamicResource Clk.Danger}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PDF 分割 (spec 4.6): three ways to split on top, page tiles below (the only part that scrolls).
                         Custom mode: click the gap between two pages to add or remove a cut. The band under each page
                         shows which part it goes to, alternating two colours. -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsSplitAction}" RowDefinitions="Auto,*" RowSpacing="12">
                        <WrapPanel Grid.Row="0" Orientation="Horizontal">
                            <ListBox Classes="segmented" SelectedIndex="{Binding Split.Mode, Mode=TwoWay}" Margin="0,0,10,0">
                                <ListBoxItem Content="自訂切點" IsEnabled="{Binding Split.IsSingleFile}" />
                                <ListBoxItem Content="每一頁一份" />
                                <ListBoxItem Content="每 N 頁一份" />
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Split.IsFixed}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="每" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding Split.PagesPerPart, Mode=TwoWay}" Minimum="1" Increment="1" FormatString="0"
                                               Width="110" VerticalAlignment="Center" />
                                <TextBlock Text="頁一份" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Split.Hint}" Classes="secondary" FontSize="13" VerticalAlignment="Center" />
                        </WrapPanel>
                        <Border Grid.Row="1" Classes="card" Padding="12">
                            <Panel>
                                <TextBlock IsVisible="{Binding Split.HasMessage}" Text="{Binding Split.Message}" Classes="secondary"
                                           FontSize="14" TextWrapping="Wrap" />
                                <ScrollViewer IsVisible="{Binding !Split.HasMessage}">
                                    <ItemsControl ItemsSource="{Binding Split.Pages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SplitPageViewModel">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <StackPanel Width="84" Spacing="4">
                                                        <Border Width="84" Height="108" CornerRadius="4" BorderThickness="1"
                                                                BorderBrush="{DynamicResource Clk.CardBorder}" Background="#FFFFFF" ClipToBounds="True">
                                                            <Panel>
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                                                                <TextBlock Text="{Binding Number}" Foreground="#9AA0A6" FontSize="20"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           IsVisible="{Binding !HasThumbnail}" />
                                                            </Panel>
                                                        </Border>
                                                        <Panel Height="4">
                                                            <Border CornerRadius="2" Background="{DynamicResource Clk.Accent}" IsVisible="{Binding IsOddPart}" />
                                                            <Border CornerRadius="2" Background="#F2A33A" IsVisible="{Binding !IsOddPart}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding Number}" FontSize="12" Classes="secondary" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                    <!-- The gap after a page: a cut shows as a dashed line with scissors-like marks. -->
                                                    <Button Width="18" Height="108" Padding="0" Margin="2,0" VerticalAlignment="Top"
                                                            Background="Transparent" BorderThickness="0" IsVisible="{Binding HasGap}"
                                                            IsEnabled="{Binding CanEditGap}" Command="{Binding ToggleCut}"
                                                            ToolTip.Tip="加上或取消切點">
                                                        <Panel>
                                                            <Rectangle Width="2" Height="96" Fill="{DynamicResource Clk.Danger}" IsVisible="{Binding CutAfter}" />
                                                            <Rectangle Width="1" Height="96" Fill="{DynamicResource Clk.Divider}" IsVisible="{Binding !CutAfter}" />
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Grid>

                    <!-- 合併與拼接 (spec 4.6): the order list is the only part that scrolls. Rows are dragged by the
                         handle or moved with ↑ ↓; the small title row is left-aligned with its buttons right after it. -->
                    <Grid Grid.Row="1" IsVisible="{Binding IsOrderAction}" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Classes="optLabel" Text="{Binding Order.Title}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Order.CountText}" Classes="secondary" FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <ListBox Classes="segmented" SelectedIndex="{Binding Order.SortIndex, Mode=TwoWay}" Margin="0,0,8,0">
                                <ListBoxItem Content="依檔名排序" />
                                <ListBoxItem Content="依修改時間" />
                            </ListBox>
                            <Button Classes="secondary" Content="反過來" Command="{Binding Order.Reverse}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <Border Grid.Row="1" Classes="card" Padding="0">
                            <ScrollViewer>
                                <ItemsControl Name="OrderList" ItemsSource="{Binding Order.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                                            <Border BorderBrush="{DynamicResource Clk.Divider}" BorderThickness="0,0,0,1" Padding="6,4,10,4"
                                                    Background="Transparent">
                                                <Grid ColumnDefinitions="Auto,32,*,Auto,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" Classes="dragHandle" Width="28" Height="32" Background="Transparent"
                                                            Cursor="SizeNorthSouth" ToolTip.Tip="拖曳調整順序">
                                                        <Viewbox Classes="ic" Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="M9,6 L9.01,6 M15,6 L15.01,6 M9,12 L9.01,12 M15,12 L15.01,12 M9,18 L9.01,18 M15,18 L15.01,18"
                                                                      StrokeThickness="3" Stroke="{DynamicResource Clk.TextTertiary}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding PositionText}" Classes="secondary" FontSize="13"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Classes="secondary" FontSize="13" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                        <Button Classes="subtle" Padding="6" ToolTip.Tip="往前" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="往前"
                                                                Command="{Binding $parent[UserControl].((vm:ConvertViewModel)DataContext).Order.MoveUp}"
                                                                CommandParameter="{Binding}">
                                                            <Viewbox Classes="ic" Width="16" Height="16"><Canvas Width="24" Height="24">
                                                                <Path Data="M12,19 V5 M6,11 L12,5 L18,11" Stroke="{DynamicResource Clk.TextSecondary}" />
                                                            </Canvas></Viewbox>
                                                        </Button>
                                                        <Button Classes="subtle" Padding="6" ToolTip.Tip="往後" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="往後"
                                                                Command="{Binding $parent[UserControl].((vm:ConvertViewModel)DataContext).Order.MoveDown}"
                                                                CommandParameter="{Binding}">
                                                            <Viewbox Classes="ic" Width="16" Height="16"><Canvas Width="24" Height="24">
                                                                <Path Data="M12,5 V19 M6,13 L12,19 L18,13" Stroke="{DynamicResource Clk.TextSecondary}" />
                                                            </Canvas></Viewbox>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock Classes="optLabel" Text="合併後的檔名" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding Order.OutputName}" />
                                <TextBlock Grid.Column="1" Text="{Binding Order.OutputExtension}" Classes="secondary" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Bar: Output Path + Start Button -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0" VerticalAlignment="Bottom">
                        <TextBlock Grid.Column="0" Text="會直接改掉原本的檔名" Classes="secondary" FontSize="14"
                                   VerticalAlignment="Center" IsVisible="{Binding IsRenameAction}" />
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding ShowsOutputLocation}">
                            <Viewbox Classes="ic" Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,4 H9 L11,6 H21 V18 H3 Z" Stroke="{DynamicResource Clk.TextSecondary}" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding OutputSummaryText}" Classes="secondary" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Name="StartConversionButton"
                                Content="{Binding StartButtonText}" MinHeight="44" Padding="32,0"
                                IsEnabled="{Binding CanStart}" />
                    </Grid>
                </Grid>

                <!-- STATE C: Managing Files Modal List -->
                <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsManagingFiles}">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding SelectedFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,0,0,6" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" Classes="secondary" FontSize="13" Margin="12,0" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="subtle" Padding="8" ToolTip.Tip="移除" AutomationProperties.Name="移除"
                                                    Command="{Binding $parent[UserControl].((vm:ConvertViewModel)DataContext).RemoveFile}"
                                                    CommandParameter="{Binding Path}">
                                                <Viewbox Classes="ic" Width="16" Height="16">
                                                    <Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Clk.TextSecondary}" /></Canvas>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Classes="primary" Name="DoneManageFilesButton" Content="完成"
                            HorizontalAlignment="Right" Margin="0,12,0,0" MinHeight="36" Padding="20,0" />
                </Grid>

                <!-- STATE E: Executing Progress -->
                <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsExecuting}">
                    <TextBlock Grid.Row="0" Text="{Binding ProgressMessage}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ProgressBar Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" Margin="0,0,0,24" />
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding SelectedFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <Border Classes="card" Margin="0,0,0,6" Padding="12,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="secondary" FontSize="13" VerticalAlignment="Center" />
                                        </Grid>                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="3" Classes="secondary" Name="CancelConversionButton" Content="取消"
                            HorizontalAlignment="Right" Margin="0,12,0,0" MinHeight="38" Padding="24,0" />
                </Grid>

                <!-- STATE F: Completed / Results -->
                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsCompleted}">
                    <TextBlock Grid.Row="0" Text="{Binding ResultSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding ResultItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,0,0,8" Padding="14,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Status Icon -->
                                            <Panel Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <!-- Same status icons as the history rows: gray ✓, red ✕ (spec 7). -->
                                                <Viewbox Classes="ic" Width="20" Height="20" IsVisible="{Binding Succeeded}">
                                                    <Canvas Width="24" Height="24"><Path Data="M5,12.5 L9.5,17 L19,7.5" Stroke="{DynamicResource Clk.TextTertiary}" /></Canvas>
                                                </Viewbox>
                                                <Viewbox Classes="ic" Width="20" Height="20" IsVisible="{Binding !Succeeded}">
                                                    <Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Clk.Danger}" /></Canvas>
                                                </Viewbox>
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DetailText}" Classes="secondary" FontSize="13" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                        <Button Grid.Column="0" Classes="secondary" Name="ProcessOtherFilesButton" Content="處理其他檔案" MinHeight="40" Padding="18,0" />
                        <Button Grid.Column="2" Classes="primary" Name="OpenOutputFolderButton" Content="開啟所在資料夾" MinHeight="40" Padding="24,0" />
                    </Grid>
                </Grid>

            </Panel>
        </Border>
    </Grid>
</UserControl>
