<!-- Shared Clickra 4.0 control styles. Apply with Classes="...", e.g. <Button Classes="primary" />.
     Rules come from docs/specs/v4_desktop_ui_layout.md (sections 4.9, 5 and 7). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Text ===== -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.groupLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
  </Style>

  <!-- ===== Containers ===== -->
  <!-- Dark block that holds a page area. Only one block per page may scroll, and only inside itself. -->
  <Style Selector="Border.section">
    <Setter Property="Background" Value="{DynamicResource Clk.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.SurfaceBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- Option card inside an action page: label on top, control full width, notes below. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Clk.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20,14" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Clk.Divider}" />
  </Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Primary: the single accent button of a screen (section 7: one per screen). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Clk.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="36,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.AccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.OnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.DisabledBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.DisabledText}" />
  </Style>

  <!-- Secondary: bordered action button. Underlined text is reserved for navigation (section 7). -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.secondary.large">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
  </Style>

  <!-- Icon-only button. Allowed only where the decision log permits it (e.g. the 關於 row);
       always give it ToolTip.Tip and AutomationProperties.Name with the action's name. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <!-- Icons are drawn on a shared 24 x 24 grid and scaled as a whole (Viewbox), so every icon keeps
       the same size, stroke weight and baseline. Never stretch a single Path to fit. -->
  <Style Selector="Button.icon Viewbox">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Button.icon Path">
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- Subtle: no border, used for low-emphasis actions such as 重新選. -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>

  <!-- Link: navigation only (switch tab / open website). Underlined. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                     FontSize="{TemplateBinding FontSize}" TextDecorations="Underline"
                     VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>

  <!-- ===== Top tabs (轉檔／歷史／設定) ===== -->
  <Style Selector="RadioButton.tab">
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent" MinHeight="44">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" Margin="14,0"
                            VerticalAlignment="Center" />
          <Border Name="PART_Underline" Height="2" VerticalAlignment="Bottom"
                  Background="{DynamicResource Clk.Accent}" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="RadioButton.tab:checked /template/ Border#PART_Underline">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- ===== Segmented buttons: a few equal choices with no order (section 4.9) ===== -->
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource Clk.SegmentTrack}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.SegmentSelected}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ===== Action directory card: icon on a light plate + name, centered, no description ===== -->
  <Style Selector="Button.actionCard">
    <Setter Property="Background" Value="{DynamicResource Clk.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.actionCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.CardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.CardBorder}" />
  </Style>
  <Style Selector="Border.iconPlate">
    <Setter Property="Width" Value="68" />
    <Setter Property="Height" Value="68" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource Clk.IconPlate}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.IconPlateBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== Toggle chip: turns one of many items on or off (right-click menu items).
       On / off differ by shape (check vs plus), not only by colour. ===== -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,0,14,0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.HoverFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.ControlBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Clk.ChipOn}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Clk.Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource Clk.Text}" />
  </Style>
  <Style Selector="ToggleButton.chip Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{Binding $parent[ToggleButton].Foreground}" />
  </Style>
  <Style Selector="ToggleButton.chip Path.checkMark">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.chip:checked Path.checkMark">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.chip:checked Path.plusMark">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===== Scroll region inside a section: thin bar, content never pushes the page ===== -->
  <Style Selector="ScrollViewer.sectionScroll">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <!-- ===== Motion: short color transitions so hover / press feel smooth (about 0.1 s) ===== -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.actionCard /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.tab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
