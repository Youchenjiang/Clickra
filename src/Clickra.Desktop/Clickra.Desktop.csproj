<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Windows publishes (-r win-*) compile Core's Windows paths in: the built-in PDF engine and WIC. -->
    <TargetFramework Condition="$(RuntimeIdentifier.StartsWith('win'))">net8.0-windows10.0.19041.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('windows'))">../../obj/icons/app.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NativeAOT trimming. build_desktop.ps1 publishes with -warnaserror, so any trim or AOT
         warning fails the publish; list each warning separately instead of one per assembly. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- PdfPig (used by Clickra.Core) resolves types through reflection. Keep the same roots as
         the CLI (src/Clickra.CLI/Clickra.csproj) so Core features survive trimming once wired. -->
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Core" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Fonts" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Package" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Tokenization" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Tokens" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clickra.Core\Clickra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon shown in the window and the top bar; source of truth is assets/primary. -->
    <AvaloniaResource Include="..\..\assets\primary\clickra-icon-primary-64.png" Link="Assets\clickra-64.png" />
    <!-- Feature vector icons for action cards and execution status. -->
    <AvaloniaResource Include="..\..\assets\features\*.svg" Link="Assets\Features\%(Filename)%(Extension)" />
    <!-- Bundled UI font (Noto Sans TC subset, OFL 1.1) so text looks the same on every platform. -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- Template card previews, generated on Windows by scripts/tools/TemplatePreviewGen. -->
    <AvaloniaResource Include="Assets\TemplatePreviews\*.png" />
  </ItemGroup>

</Project>
