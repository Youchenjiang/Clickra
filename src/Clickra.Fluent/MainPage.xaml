<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI Variable">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            PaneDisplayMode="Top"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Overview" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Convert" Tag="Convert">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Clickra" FontSize="36" FontWeight="SemiBold"/>
                                <TextBlock Text="File conversion workspace" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="10" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OpenConvertButton" Content="Open Convert" Padding="18,10"/>
                                    <Button x:Name="ViewHistoryButton" Grid.Column="1" Content="View History" Padding="18,10"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Status" FontSize="15" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="PDF tools" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Office tools" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Total jobs" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="StatTotal" Text="0" FontSize="32" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Success" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="StatSuccess" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Failed" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="StatFailed" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0">
                            <TextBlock Text="Explorer integration stays available" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Right-click files in Explorer for the context menu, or use Convert here for a full Fluent progress view." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConvertPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="18">
                            <TextBlock Text="Convert" FontSize="34" FontWeight="SemiBold"/>
                            <Grid x:Name="DropZone" AllowDrop="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="28" MinHeight="210">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                    <FontIcon Glyph="&#xE896;" FontSize="52" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Drop files here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click this area to browse" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="PDF, Office documents, and images" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Selected files" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Files are validated against the selected command." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ClearFilesButton" Content="Clear" Padding="16,8"/>
                                <StackPanel x:Name="FileListContainer" Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,14,0,0">
                                    <TextBlock x:Name="EmptyFileMessage" Text="No files selected" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="14">
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Command" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CommandStatusText" Text="Choose a command" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Office" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="BtnWord2Pdf" Content="Word" Tag="word2pdf"/>
                                            <Button x:Name="BtnExcel2Pdf" Grid.Column="1" Content="Excel" Tag="excel2pdf"/>
                                            <Button x:Name="BtnPpt2Pdf" Grid.Column="2" Content="PPT" Tag="ppt2pdf"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="PDF" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Button x:Name="BtnMergePdf" Content="Merge" Tag="merge-pdf"/>
                                            <Button x:Name="BtnCompressPdf" Grid.Column="1" Content="Compress" Tag="compress-pdf"/>
                                            <Button x:Name="BtnTranslatePdf" Grid.Row="1" Content="Translate" Tag="translate-pdf"/>
                                            <Button x:Name="BtnDecryptPdf" Grid.Row="1" Grid.Column="1" Content="Decrypt" Tag="decrypt-pdf"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Image" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button x:Name="BtnImg2Pdf" Content="PDF" Tag="img2pdf"/>
                                            <Button x:Name="BtnImgMerge" Grid.Column="1" Content="Merge" Tag="img-merge"/>
                                            <Button x:Name="BtnImgStitch" Grid.Column="2" Content="Stitch" Tag="img-stitch"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Run" FontSize="15" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button x:Name="StartButton" Content="Start conversion" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Padding="18,10"/>
                                        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed" Padding="16,10"/>
                                    </Grid>
                                    <Grid x:Name="ConversionProgressSection" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="ConversionProgressText" Text="Ready" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ProgressBar x:Name="ConversionProgressBar" Minimum="0" Maximum="100"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="History" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="Recent conversion results" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ClearHistoryButton" Content="Clear" VerticalAlignment="Center" Padding="18,10"/>
                    </Grid>
                    <Grid x:Name="ActiveJobSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Active job" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ActiveJobText" Text="Converting..." FontSize="13"/>
                            <ProgressBar x:Name="ActiveJobProgress" IsIndeterminate="True"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="EmptyHistoryState" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="28">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="No conversion history yet." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="HistoryListContainer" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Settings" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock Text="Defaults used by the dashboard and Explorer commands" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Output directory" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Where converted files are saved" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="OutputDirCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="Same as source"/>
                                    <ComboBoxItem Content="Desktop"/>
                                    <ComboBoxItem Content="Downloads"/>
                                    <ComboBoxItem Content="Custom..."/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Office engine" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Engine used for Office conversion" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="EngineCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="Microsoft Office"/>
                                    <ComboBoxItem Content="LibreOffice"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Language" FontSize="15" FontWeight="SemiBold"/>
                                <ComboBox x:Name="LanguageCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="繁體中文 (zh-TW)"/>
                                    <ComboBoxItem Content="简体中文 (zh-CN)"/>
                                    <ComboBoxItem Content="English (en-US)"/>
                                    <ComboBoxItem Content="日本語 (ja-JP)"/>
                                    <ComboBoxItem Content="한국어 (ko-KR)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="PDF translation target" FontSize="15" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PdfLangCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="繁體中文 (zh-TW)"/>
                                    <ComboBoxItem Content="English (en)"/>
                                    <ComboBoxItem Content="简体中文 (zh-CN)"/>
                                    <ComboBoxItem Content="日本語 (ja)"/>
                                    <ComboBoxItem Content="한국어 (ko)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Behavior" FontSize="15" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Quiet mode"/>
                                        <TextBlock Text="Process files without showing UI" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="QuietModeToggle" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Notifications"/>
                                        <TextBlock Text="Show toast when conversion completes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotificationToggle" Grid.Column="1" IsOn="True" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PDF compression" FontSize="15" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="CompressionSlider" Minimum="0" Maximum="3" Value="1"/>
                                    <TextBlock x:Name="CompressionLabel" Grid.Column="1" Text="Standard" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Strip fonts" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="StripFontsToggle" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Minify content" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="MinifyContentToggle" Grid.Column="1" IsOn="True"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="72" Height="72" Source="ms-appx:///Assets/AppIcon.png" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="8" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Clickra" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="Version 3.6.4" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="A Fluent file conversion workspace for Windows." FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="View on GitHub" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Platform" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Windows 11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Framework" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="WinUI 3"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <TextBlock Text="© 2026 Clickra" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
