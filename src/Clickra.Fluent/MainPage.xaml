<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Clickra_Fluent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI Variable Display">

    <NavigationView x:Name="NavView" 
                    PaneDisplayMode="Top"
                    IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsTitleBarAutoPaddingEnabled="False"
                    Background="Transparent"
                    SelectedItem="OverviewItem">
        
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="OverviewItem" Content="Overview" Tag="Overview">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE80F;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ConvertItem" Content="Convert" Tag="Convert">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B7;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="Settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <!-- Overview Panel -->
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24" Margin="24,24,24,24">
                    
                    <!-- Engine Status -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Engine Status" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                  CornerRadius="8" Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#22c55e" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="PDF Processing" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                  CornerRadius="8" Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#22c55e" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Office Conversion" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Statistics -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Statistics" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                              CornerRadius="8" Padding="16,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Success" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="0" FontSize="28" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Quick Tip -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Quick Tip" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                              CornerRadius="8" Padding="16,14">
                            <TextBlock Text="Right-click any file in Explorer to access Clickra's conversion tools directly from the context menu."
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Convert Panel -->
            <ScrollViewer x:Name="ConvertPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="24" Margin="24,24,24,24">
                    <TextBlock Text="Convert" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Drag and drop files here, or click to browse." 
                                       FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Browse Files" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- History Panel -->
            <ScrollViewer x:Name="HistoryPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="24" Margin="24,24,24,24">
                    <TextBlock Text="History" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="24">
                        <TextBlock Text="No conversion history yet." 
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings Panel -->
            <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,24,24,24">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                    
                    <!-- Output Directory -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Output Directory" FontSize="14" FontWeight="SemiBold"/>
                            <ComboBox x:Name="OutputDirCombo" Margin="0,8,0,0" MinWidth="200">
                                <ComboBoxItem Content="Same as source" IsSelected="True"/>
                                <ComboBoxItem Content="Desktop"/>
                                <ComboBoxItem Content="Downloads"/>
                                <ComboBoxItem Content="Custom..."/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Office Engine -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Office Engine" FontSize="14" FontWeight="SemiBold"/>
                            <ComboBox x:Name="EngineCombo" Margin="0,8,0,0" MinWidth="200">
                                <ComboBoxItem Content="Auto" IsSelected="True"/>
                                <ComboBoxItem Content="Microsoft Office"/>
                                <ComboBoxItem Content="LibreOffice"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Language -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Language" FontSize="14" FontWeight="SemiBold"/>
                            <ComboBox x:Name="LanguageCombo" Margin="0,8,0,0" MinWidth="200">
                                <ComboBoxItem Content="Traditional Chinese (zh-TW)" IsSelected="True"/>
                                <ComboBoxItem Content="Simplified Chinese (zh-CN)"/>
                                <ComboBoxItem Content="English (en-US)"/>
                                <ComboBoxItem Content="Japanese (ja-JP)"/>
                                <ComboBoxItem Content="Korean (ko-KR)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Quiet Mode Toggle -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quiet Mode" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Process files without showing UI" FontSize="13" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="QuietModeToggle" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Notification Toggle -->
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                          CornerRadius="8" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Show toast notifications when conversion completes" FontSize="13" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="NotificationToggle" IsOn="True" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- About Panel (placeholder) -->
            <Grid x:Name="AboutPanel" Visibility="Collapsed">
                <TextBlock Text="About" FontSize="20" FontWeight="SemiBold" Margin="24,24,0,0"/>
            </Grid>
        </Grid>
    </NavigationView>
</Page>