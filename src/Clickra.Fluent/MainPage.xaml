<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Clickra_Fluent"
    mc:Ignorable="d"
    FontFamily="Segoe UI Variable">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            PaneDisplayMode="Top"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavOverviewItem" Content="Overview" Tag="Overview" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavConvertItem" Content="Convert" Tag="Convert">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistoryItem" Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettingsItem" Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAboutItem" Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="OverviewLayout" Margin="36,22,36,26" ColumnSpacing="14" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="OverviewMainColumn" Width="1.4*"/>
                        <ColumnDefinition x:Name="OverviewSideColumn" Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" MinHeight="148">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="OverviewConvertTitle" Text="Convert Files" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverviewConvertSubtitle" Text="PDF, Office, Markdown, and image tools in one workspace." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnSpacing="10" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="OpenConvertButton" Content="Choose Files" Padding="16,8"/>
                                    <Button x:Name="ViewHistoryButton" Grid.Column="1" Content="Recent Jobs" Padding="16,8"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OverviewRecentTitle" Text="Recent Activity" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OverviewNoHistoryText" Text="No conversion history yet." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel x:Name="OverviewRecentContainer" Spacing="8"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="OverviewSidePane" Grid.Column="1" Spacing="12">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="OverviewActivityTitle" Text="Activity Summary" FontSize="14" FontWeight="SemiBold"/>
                                <Grid x:Name="OverviewStatsGrid" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="OverviewTotalLabel" Text="Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="StatTotal" Text="0" FontSize="22" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock x:Name="OverviewOkLabel" Text="Success" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="StatSuccess" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock x:Name="OverviewFailLabel" Text="Failed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="StatFailed" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewToolsLabel" Grid.Column="1" Text="PDF &amp; Office Tools" FontSize="13" Margin="2,0,0,0"/>
                                    <TextBlock x:Name="OverviewToolsReady" Grid.Column="2" Text="Ready" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OverviewExplorerLabel" Grid.Column="1" Text="File Explorer Menu" FontSize="13" Margin="2,0,0,0"/>
                                    <TextBlock x:Name="OverviewExplorerReady" Grid.Column="2" Text="Available" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA90;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="OverviewPdfTitle" Text="PDF" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OverviewPdfDesc" Text="Merge, compress, translate, decrypt." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="OverviewOfficeTitle" Text="Office" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OverviewOfficeDesc" Text="Word, Excel, PowerPoint to PDF." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEB9F;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="OverviewImagesTitle" Text="Images" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OverviewImagesDesc" Text="Create PDF, merge, stitch." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="ConvertPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="14" Margin="32,20,32,24">
                    <TextBlock x:Name="ConvertTitle" Text="Convert" FontSize="30" FontWeight="SemiBold"/>
                    <Grid x:Name="ConvertLayout" ColumnSpacing="20" RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ConvertMainColumn" Width="1.15*"/>
                            <ColumnDefinition x:Name="ConvertSideColumn" Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DropZone" Grid.ColumnSpan="2" AllowDrop="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14" MinHeight="124">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                <FontIcon x:Name="DropZoneIcon" Glyph="&#xE896;" FontSize="30" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="DropZoneTitle" Text="Drag and drop files here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DropZoneBrowseText" Text="Click to select files" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DropZoneTypesText" Text="PDF, Office, Markdown, and images" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="SelectedFilesCard" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedFilesTitle" Text="Selected Files" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedFilesDesc" Text="Files are validated according to the command." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="ClearFilesButton" Content="Clear" Padding="16,8"/>
                            <StackPanel x:Name="FileListContainer" Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,14,0,0">
                                <TextBlock x:Name="EmptyFileMessage" Text="No files selected" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ConvertCommandCard" Grid.Row="2" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="CommandTitle" Text="Command" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CommandStatusText" Text="Select command" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="OfficeCommandLabel" Text="Office" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Grid x:Name="OfficeCommandGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button x:Name="BtnWord2Pdf" Content="Word" Tag="word2pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnExcel2Pdf" Grid.Column="1" Content="Excel" Tag="excel2pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnPpt2Pdf" Grid.Column="2" Content="PPT" Tag="ppt2pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnMd2Pdf" Grid.Row="1" Grid.ColumnSpan="2" Content="Markdown → PDF" Tag="md2pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnMd2Word" Grid.Row="1" Grid.Column="2" Content="Markdown → Word" Tag="md2word" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="PdfCommandLabel" Text="PDF" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Grid x:Name="PdfCommandGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button x:Name="BtnMergePdf" Content="Merge PDF" Tag="merge-pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnCompressPdf" Grid.Column="1" Content="Compress PDF" Tag="compress-pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnTranslatePdf" Grid.Column="2" Content="Translate PDF" Tag="translate-pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnDecryptPdf" Grid.Column="3" Content="Decrypt PDF" Tag="decrypt-pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnSplitPdf" Grid.Column="4" Content="Split PDF" Tag="split-pdf" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ImageCommandLabel" Text="Images" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Grid x:Name="ImageCommandGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Button x:Name="BtnImg2Pdf" Content="PDF" Tag="img2pdf" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgMerge" Grid.Column="1" Content="Merge Images" Tag="img-merge" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgStitch" Grid.Column="2" Content="Stitch Images" Tag="img-stitch" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgToPng" Grid.Column="3" Content="PNG" Tag="img-to-png" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgToJpg" Grid.Row="1" Content="JPG" Tag="img-to-jpg" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgToWebp" Grid.Row="1" Grid.Column="1" Content="WebP" Tag="img-to-webp" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgToGif" Grid.Row="1" Grid.Column="2" Content="GIF" Tag="img-to-gif" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="BtnImgToHeic" Grid.Row="1" Grid.Column="3" Content="HEIC" Tag="img-to-heic" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ConvertRunCard" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RunTitle" Text="Run" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="StartButton" Content="Start Conversion" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Padding="16,7"/>
                                        <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="16,7"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="ConversionProgressSection" Visibility="Collapsed" Margin="0,2,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ConversionProgressText" Text="Ready" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ProgressBar x:Name="ConversionProgressBar" Minimum="0" Maximum="100"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid x:Name="HistoryLayout" Margin="36,28,36,32" ColumnSpacing="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HistoryTopRow" Height="*"/>
                    <RowDefinition x:Name="HistoryDetailRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HistoryListColumn" Width="430"/>
                    <ColumnDefinition x:Name="HistoryDetailColumn" Width="*"/>
                </Grid.ColumnDefinitions>                    <Grid x:Name="HistoryListPane" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="HistoryTitle" Text="History" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistorySubtitle" Text="Recent Conversion Results" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ClearHistoryButton" Content="Clear" VerticalAlignment="Center" Padding="18,10"/>
                    </Grid>

                    <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="HistoryTotalText" Text="0" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistoryTotalLabel" Text="Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="HistorySuccessText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#39D353"/>
                            <TextBlock x:Name="HistorySuccessLabel" Text="Success" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Name="HistoryFailedText" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                            <TextBlock x:Name="HistoryFailedLabel" Text="Failed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Conversions running in another window or from the command line. The Win32
                         dashboard already lists these rows, so the same shared feed feeds this one. -->
                    <Grid Grid.Row="2" x:Name="ActiveTasksSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ActiveTasksTitle" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel x:Name="ActiveTasksContainer" Spacing="8"/>
                        </StackPanel>
                    </Grid>

                    <!-- Parked conversions: the toast promises they can be resumed or cancelled
                         from the History page, so that entry point lives here. -->
                    <Grid Grid.Row="3" x:Name="ParkedTasksSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="ParkedTasksTitle" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ParkedTasksDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel x:Name="ParkedTasksContainer" Spacing="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" x:Name="ActiveJobSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ActiveJobTitle" Text="Run" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ActiveJobText" Text="Converting..." FontSize="13"/>
                            <ProgressBar x:Name="ActiveJobProgress" IsIndeterminate="True"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" x:Name="EmptyHistoryState" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="28">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="EmptyHistoryText" Text="No conversion history yet." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="HistoryListScrollViewer" Grid.Row="6" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryListContainer" Spacing="8" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Column="1" x:Name="HistoryDetailPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="22">
                    <ScrollViewer x:Name="HistoryDetailScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HistoryDetailContainer" Spacing="14"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SettingsSubtitle" Text="Default settings for user interface and commands" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid x:Name="SettingsLayout" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OutputDirTitle" Text="Output Folder" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OutputDirDesc" Text="Location to save converted files" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="OutputDirCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem x:Name="OutputDirSourceItem" Content="Same as source"/>
                                    <ComboBoxItem x:Name="OutputDirDesktopItem" Content="Desktop"/>
                                    <ComboBoxItem x:Name="OutputDirDownloadsItem" Content="Downloads"/>
                                    <ComboBoxItem x:Name="OutputDirCustomItem" Content="Custom..."/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="OfficeEngineTitle" Text="Office Engine" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OfficeEngineDesc" Text="Engine used for Office conversions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="EngineCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem x:Name="EngineAutoItem" Content="Auto"/>
                                    <ComboBoxItem x:Name="EngineMicrosoftItem" Content="Microsoft Office"/>
                                    <ComboBoxItem x:Name="EngineLibreOfficeItem" Content="LibreOffice"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="LanguageTitle" Text="Default Language" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LanguageDesc" Text="Used for interface, explorer commands, and messages." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="LanguageCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="繁體中文 (zh-TW)"/>
                                    <ComboBoxItem Content="简体中文 (zh-CN)"/>
                                    <ComboBoxItem Content="English (en-US)"/>
                                    <ComboBoxItem Content="日本語 (ja-JP)"/>
                                    <ComboBoxItem Content="한국어 (ko-KR)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PdfTargetTitle" Text="PDF Translation Target" FontSize="15" FontWeight="SemiBold"/>
                                <ComboBox x:Name="PdfLangCombo" MinWidth="260" SelectedIndex="0">
                                    <ComboBoxItem Content="繁體中文 (zh-TW)"/>
                                    <ComboBoxItem Content="English (en)"/>
                                    <ComboBoxItem Content="简体中文 (zh-CN)"/>
                                    <ComboBoxItem Content="日本語 (ja)"/>
                                    <ComboBoxItem Content="한국어 (ko)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock x:Name="BehaviorTitle" Text="Behavior" FontSize="15" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="QuietModeTitle" Text="Quiet Mode"/>
                                        <TextBlock x:Name="QuietModeDesc" Text="Default for explorer commands; this window remains visible." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="QuietModeToggle" Grid.Column="1" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="NotificationTitle" Text="Notifications"/>
                                        <TextBlock x:Name="NotificationDesc" Text="Show notifications when conversions complete" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotificationToggle" Grid.Column="1" IsOn="True" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="PdfCompressionTitle" Text="PDF Compression" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PdfCompressImageGroupTitle" Text="Image Compression" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider x:Name="CompressionSlider" Value="1"/>
                                    <TextBlock x:Name="CompressionLabel" Grid.Column="1" Text="Standard" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="PdfCompressOtherGroupTitle" Text="Other Optimization" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StripFontsTitle" Text="Strip embedded fonts" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="StripFontsToggle" Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MinifyContentTitle" Text="Minify content streams" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="MinifyContentToggle" Grid.Column="1" IsOn="True"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ParkedRetentionCard" Grid.Row="3" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ParkedRetentionTitle" Text="Parked Retention" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ParkedRetentionDesc" Text="Retention days for parked conversions (0 = unlimited)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumberBox x:Name="ParkedRetentionBox" Grid.Column="1" MinWidth="160" SmallChange="1" SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="LibreOffice" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LibreOfficeStatusText" Text="LibreOffice not configured" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LibreOfficePathText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="LibreOfficeSetupProgress" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <Grid x:Name="LibreOfficeButtonRow" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="LibreOfficeBrowseButton" Content="Browse..." Padding="14,8"/>
                                    <Button x:Name="LibreOfficeDownloadButton" Grid.Column="1" Content="Get LibreOffice" Padding="14,8"/>
                                    <Button x:Name="LibreOfficeUninstallButton" Grid.Column="2" Content="Uninstall LibreOffice" Padding="14,8"/>
                                    <Button x:Name="LibreOfficeAdoptButton" Grid.Column="3" Content="Manage with Clickra" Padding="14,8" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="18" Margin="36,28,36,32">
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="72" Height="72" Source="ms-appx:///Assets/AppIcon.png" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="8" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Clickra" FontSize="34" FontWeight="SemiBold"/>
                            <TextBlock Text="Version 3.6.4" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="AboutDescription" Text="Clickra is a fast, lightweight file conversion workspace on Windows." FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AboutLayout" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="GitHubButton" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71B;" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="GitHubText" Grid.Column="1" Text="View on GitHub" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </Button>
                        <Button x:Name="OpenDataDirButton" Grid.Column="1" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE838;" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="OpenDataDirText" Grid.Column="1" Text="Open log directory" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </Button>
                        <Button x:Name="GmailButton" Grid.Row="1" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE715;" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="GmailText" Grid.Column="1" Text="Report via Gmail" VerticalAlignment="Center"/>
                            <FontIcon Grid.Column="2" Glyph="&#xE8A7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        </Button>
                        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PlatformLabel" Text="Platform" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Windows 11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="AppModelLabel" Text="Application Model" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Desktop"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <TextBlock Text="© 2026 Clickra" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Full-window visual splitter, shown while the user builds the split spec. -->
        <local:SplitPagesOverlay x:Name="SplitOverlay" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
</Page>
