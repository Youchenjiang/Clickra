<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="Segoe UI Variable Display">

    <NavigationView x:Name="NavView" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" IsTitleBarAutoPaddingEnabled="False" Background="Transparent" SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Overview" Tag="Overview" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Convert" Tag="Convert"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="History" Tag="History"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="About" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid>
            <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="24,16,24,24">
                    <TextBlock Text="Overview" FontSize="28" FontWeight="SemiBold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Engine Status" FontSize="14" FontWeight="SemiBold"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="PDF Processing" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Office Conversion" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Statistics" FontSize="14" FontWeight="SemiBold"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock Text="Total" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatTotal" Text="0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="Success" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatSuccess" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center"/></StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,4"/>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center"><TextBlock Text="Failed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="StatFailed" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8"><TextBlock Text="Quick Tip" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Right-click any file in Explorer to access Clickra's conversion tools directly from the context menu." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConvertPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,16,24,24">
                    <TextBlock Text="Convert" FontSize="28" FontWeight="SemiBold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24" x:Name="DropZone" AllowDrop="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="48" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Drag and drop files here" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="or click to browse" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="PDF, Word, Excel, PowerPoint, Images" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected Files" FontSize="14" FontWeight="SemiBold"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="Clear" x:Name="ClearFilesButton"/>
                        <StackPanel x:Name="FileListContainer" Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                            <TextBlock x:Name="EmptyFileMessage" Text="No files selected" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Conversion Command" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CommandStatusText" Text="Choose a command" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Office" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Word to PDF" Tag="word2pdf" x:Name="BtnWord2Pdf"/><Button Content="Excel to PDF" Tag="excel2pdf" x:Name="BtnExcel2Pdf"/><Button Content="PPT to PDF" Tag="ppt2pdf" x:Name="BtnPpt2Pdf"/></StackPanel>
                            <TextBlock Text="PDF" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Merge" Tag="merge-pdf" x:Name="BtnMergePdf"/><Button Content="Compress" Tag="compress-pdf" x:Name="BtnCompressPdf"/><Button Content="Translate" Tag="translate-pdf" x:Name="BtnTranslatePdf"/><Button Content="Decrypt" Tag="decrypt-pdf" x:Name="BtnDecryptPdf"/></StackPanel>
                            <TextBlock Text="Image" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Image to PDF" Tag="img2pdf" x:Name="BtnImg2Pdf"/><Button Content="Merge" Tag="img-merge" x:Name="BtnImgMerge"/><Button Content="Stitch" Tag="img-stitch" x:Name="BtnImgStitch"/></StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Padding="20,12"/>
                        <Button x:Name="StartButton" Content="Start Conversion" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Padding="24,12"/>
                    </StackPanel>
                    <Grid x:Name="ConversionProgressSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ConversionProgressText" Text="Ready" FontSize="13"/>
                            <ProgressBar x:Name="ConversionProgressBar" Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,16,24,24">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="History" FontSize="28" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="Clear" x:Name="ClearHistoryButton" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="ActiveJobSection" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Visibility="Collapsed">
                        <StackPanel Spacing="8"><TextBlock Text="Active Job" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="ActiveJobText" Text="Converting..." FontSize="13"/><ProgressBar x:Name="ActiveJobProgress" IsIndeterminate="True"/></StackPanel>
                    </Grid>
                    <Grid x:Name="EmptyHistoryState" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="24">
                        <TextBlock Text="No conversion history yet." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="HistoryListContainer" Spacing="8"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,16,24,24">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Output Directory" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Choose where converted files are saved" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ComboBox x:Name="OutputDirCombo" MinWidth="200" SelectedIndex="0"><ComboBoxItem Content="Same as source"/><ComboBoxItem Content="Desktop"/><ComboBoxItem Content="Downloads"/><ComboBoxItem Content="Custom..."/></ComboBox></StackPanel></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Office Engine" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Select engine for Office conversion" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ComboBox x:Name="EngineCombo" MinWidth="200" SelectedIndex="0"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Microsoft Office"/><ComboBoxItem Content="LibreOffice"/></ComboBox></StackPanel></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="Language" FontSize="14" FontWeight="SemiBold"/><ComboBox x:Name="LanguageCombo" MinWidth="200" SelectedIndex="0"><ComboBoxItem Content="繁體中文 (zh-TW)"/><ComboBoxItem Content="简体中文 (zh-CN)"/><ComboBoxItem Content="English (en-US)"/><ComboBoxItem Content="日本語 (ja-JP)"/><ComboBoxItem Content="한국어 (ko-KR)"/></ComboBox></StackPanel></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="Quiet Mode" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Process files without showing UI" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="QuietModeToggle" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Show toast when conversion completes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="NotificationToggle" IsOn="True" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="PDF Translation Target" FontSize="14" FontWeight="SemiBold"/><ComboBox x:Name="PdfLangCombo" MinWidth="200" SelectedIndex="0"><ComboBoxItem Content="繁體中文 (zh-TW)"/><ComboBoxItem Content="English (en)"/><ComboBoxItem Content="简体中文 (zh-CN)"/><ComboBoxItem Content="日本語 (ja)"/><ComboBoxItem Content="한국어 (ko)"/></ComboBox></StackPanel></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="10"><TextBlock Text="PDF Compression" FontSize="14" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider x:Name="CompressionSlider" Grid.Column="0" Minimum="0" Maximum="3" Value="1"/><TextBlock x:Name="CompressionLabel" Grid.Column="1" Text="Standard" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Strip Fonts" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" x:Name="StripFontsToggle" Margin="16,0,0,0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Minify Content" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" x:Name="MinifyContentToggle" IsOn="True" Margin="16,0,0,0"/></Grid></StackPanel></Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="16" Margin="24,16,24,24">
                    <TextBlock Text="About" FontSize="28" FontWeight="Bold"/>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="Clickra" FontSize="22" FontWeight="Bold"/><TextBlock Text="Version 3.6.4" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="A modern Windows utility that adds powerful file conversion tools to your right-click context menu." FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Grid.Column="0" Glyph="&#xE71B;" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="View on GitHub" VerticalAlignment="Center"/><FontIcon Grid.Column="2" Glyph="&#xE8A7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></Grid>
                    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="Platform" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Windows 11" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Framework" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="WinUI 3" FontSize="13"/></StackPanel></Grid></StackPanel></Grid>
                    <TextBlock Text="© 2026 Clickra" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
