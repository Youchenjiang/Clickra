<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Clickra_Fluent.SplitPagesOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clickra_Fluent">

    <!-- 背景不設色：讓視窗的 Mica 透出（與 dashboard 一致）；卡片維持不透明 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: splitter title + source file, actions on the right. -->
        <Grid Grid.Row="0" Padding="20,10" ColumnSpacing="16"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="OverlayTitle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="OverlayFile" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CancelBtn" MinWidth="88" Click="CancelBtn_Click"/>
                <Button x:Name="ConfirmBtn" MinWidth="110" Style="{StaticResource AccentButtonStyle}" Click="ConfirmBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- The splitter stretches to the remaining window height, so the page
             preview gets the full vertical space (portrait pages need height). -->
        <Border x:Name="SplitterHost" Grid.Row="1" Margin="24,14,24,18"/>
    </Grid>
</UserControl>
