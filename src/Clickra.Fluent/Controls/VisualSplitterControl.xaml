<UserControl
    x:Class="Clickra_Fluent.VisualSplitterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="240"
    d:DesignWidth="540"
    Width="540"
    Height="240">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Mode bar: three mode buttons side by side (custom / each page / fixed pages),
             with a -/+ pages-per-segment stepper for fixed-pages mode, mirroring the CLI. -->
        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <RadioButton x:Name="ModeCustomBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
                <RadioButton x:Name="ModeEachBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
                <RadioButton x:Name="ModeFixedBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="NSelector" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="NMinusBtn" Content="&#x2212;" Width="30" Padding="0,3"/>
                <TextBlock x:Name="NLabel" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center"/>
                <Button x:Name="NPlusBtn" Content="&#xFF0B;" Width="30" Padding="0,3"/>
            </StackPanel>
        </Grid>

        <!-- Body: segment list + preview -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: segment list -->
            <Grid Grid.Column="0" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SegmentHeader" FontWeight="SemiBold" Margin="4,0,0,0"/>
                <ListView x:Name="SegmentList" Grid.Row="1" SelectionMode="Single" BorderThickness="1"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                    <Button x:Name="AddSegmentBtn" Content="＋ 新增" Padding="8,2"/>
                    <Button x:Name="DeleteSegmentBtn" Content="刪除" Padding="8,2"/>
                    <Button x:Name="ClearSegmentsBtn" Content="清空" Padding="8,2"/>
                </StackPanel>
            </Grid>

            <!-- Right: preview -->
            <Grid Grid.Column="1" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Output badge: [PDF] filename (N pages) -->
                <Border x:Name="OutputBadge" Background="#193C23" BorderBrush="#328C46" BorderThickness="1" CornerRadius="3" Padding="6,2">
                    <TextBlock x:Name="OutputBadgeText" Foreground="#78F08C" FontSize="12"/>
                </Border>

                <!-- Page navigation bar: < P.x (第 y/N 頁) 切開 > -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <Button x:Name="PrevPageBtn" Content="&#x25C0;" MinWidth="30" Padding="6,2"/>
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="120" TextAlignment="Center"/>
                    <Button x:Name="SplitAtPageBtn" Content="切開" Padding="8,2"/>
                    <Button x:Name="NextPageBtn" Content="&#x25B6;" MinWidth="30" Padding="6,2"/>
                </StackPanel>

                <!-- Preview box: paper-white page with border and a [放大] tag -->
                <Border Grid.Row="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Image x:Name="FitImage" Stretch="Uniform"/>
                        <Border x:Name="ZoomTag" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#CC14191F" CornerRadius="2" Padding="4,1" Margin="0,0,4,4">
                            <TextBlock x:Name="ZoomTagText" Foreground="#F0F0F0" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
