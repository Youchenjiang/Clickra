<UserControl
    x:Class="Clickra_Fluent.VisualSplitterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="240"
    d:DesignWidth="540"
    Width="540"
    Height="240">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Mode bar: three mode buttons side by side (custom / each page / fixed pages),
             with a -/+ pages-per-segment stepper for fixed-pages mode, mirroring the CLI. -->
        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <RadioButton x:Name="ModeCustomBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
                <RadioButton x:Name="ModeEachBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
                <RadioButton x:Name="ModeFixedBtn" GroupName="SplitMode" Padding="10,4" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="NSelector" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="NMinusBtn" Content="&#x2212;" Width="30" Padding="0,3"/>
                <TextBlock x:Name="NLabel" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center"/>
                <Button x:Name="NPlusBtn" Content="&#xFF0B;" Width="30" Padding="0,3"/>
            </StackPanel>
        </Grid>

        <!-- Body: segment list + preview -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: segment list -->
            <Grid Grid.Column="0" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SegmentHeader" FontWeight="SemiBold" Margin="4,0,0,0"/>
                <ListView x:Name="SegmentList" Grid.Row="1" SelectionMode="Single" BorderThickness="1"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                    <Button x:Name="AddSegmentBtn" Content="＋ 新增" Padding="8,2"/>
                    <Button x:Name="DeleteSegmentBtn" Content="刪除" Padding="8,2"/>
                    <Button x:Name="ClearSegmentsBtn" Content="清空" Padding="8,2"/>
                </StackPanel>
            </Grid>

            <!-- Right: preview -->
            <Grid Grid.Column="1" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Output badge: [PDF] filename (N pages) -->
                <Border x:Name="OutputBadge" Background="#193C23" BorderBrush="#328C46" BorderThickness="1" CornerRadius="3" Padding="6,2">
                    <TextBlock x:Name="OutputBadgeText" Foreground="#78F08C" FontSize="12"/>
                </Border>

                <!-- Page navigation bar: < P.x (第 y/N 頁) 切開 > -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <Button x:Name="PrevPageBtn" Content="&#x25C0;" MinWidth="30" Padding="6,2"/>
                    <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="120" TextAlignment="Center"/>
                    <Button x:Name="SplitAtPageBtn" Content="切開" Padding="8,2"/>
                    <Button x:Name="NextPageBtn" Content="&#x25B6;" MinWidth="30" Padding="6,2"/>
                </StackPanel>

                <!-- Preview box: paper-white page with border and a [放大] tag. Clicking the
                     preview (or the tag) opens the zoom lightbox, mirroring the CLI. -->
                <Border x:Name="PreviewBox" Grid.Row="2" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        PointerPressed="PreviewBox_PointerPressed">
                    <Grid>
                        <Image x:Name="FitImage" Stretch="Uniform"/>
                        <Border x:Name="ZoomTag" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#CC14191F" CornerRadius="2" Padding="4,1" Margin="0,0,4,4">
                            <TextBlock x:Name="ZoomTagText" Foreground="#F0F0F0" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Zoom lightbox overlay: dimmed backdrop, modal frame with title, close button,
             scrollable high-res page image and zoom controls (wheel / drag / buttons), all
             mirroring the CLI lightbox. -->
        <Grid x:Name="ZoomOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#EB0F1218"
              PointerWheelChanged="ZoomOverlay_PointerWheelChanged"
              PointerPressed="ZoomOverlay_PointerPressed"
              KeyDown="ZoomOverlay_KeyDown">
            <Border x:Name="ZoomModal" Width="472" Height="220" Background="#20232A" BorderBrush="#505A6E" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,8,14,0">
                        <TextBlock x:Name="ZoomTitle" Foreground="#E6F0FF" VerticalAlignment="Center" FontSize="13"/>
                        <Button x:Name="ZoomCloseBtn" Content="X 關閉" HorizontalAlignment="Right" Background="#B52D28"
                                Foreground="White" Padding="10,3" FontSize="12" Click="ZoomCloseBtn_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="ZoomScroll" Grid.Row="1" Margin="14,8"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Disabled">
                        <Image x:Name="ZoomImage" Stretch="None"
                               PointerPressed="ZoomImage_PointerPressed"
                               PointerMoved="ZoomImage_PointerMoved"
                               PointerReleased="ZoomImage_PointerReleased"
                               PointerCanceled="ZoomImage_PointerReleased"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="14,0,14,8">
                        <TextBlock x:Name="ZoomHint" Foreground="#8C8C8C" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button x:Name="ZoomOutBtn" Content="&#x2212;" Width="30" Padding="0,3" FontSize="13" Click="ZoomOutBtn_Click"/>
                            <Button x:Name="ZoomInBtn" Content="&#xFF0B;" Width="30" Padding="0,3" FontSize="13" Click="ZoomInBtn_Click"/>
                            <Button x:Name="ZoomFitBtn" Content="適配" Padding="10,3" FontSize="12" Click="ZoomFitBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
