<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.TaskProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clickra_Fluent">
    <Grid>
    <!-- 背景不設色：視窗 Mica（或 MainWindow 的 Mica）透出，與 dashboard 一致。
         x:Name 供分割介面顯示時收合本卡，避免透明覆蓋層讓它透出來疊字。 -->
    <ScrollViewer
        x:Name="ProgressCardHost"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <!-- MinHeight 綁定視窗高度：內容不足一窗時垂直置中，超長（錯誤訊息）時可捲動。 -->
        <Grid
            MinHeight="{Binding ElementName=ProgressCardHost, Path=ActualHeight}"
            Padding="28,20">
            <!-- IDM 式緊湊排版：狀態圖示+標題一列、檔名縮排、進度條與 % 同一列、按鈕右下。
                 取消大徽章與 44px 大百分比——那兩者正是「內容垂直散開」的來源。 -->
            <StackPanel
                x:Name="LayoutRoot"
                MaxWidth="460"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Spacing="12">

                <!-- 列 1：狀態圖示 + 任務名稱 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="StatusIcon"
                        Glyph="&#xE895;"
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- 目前檔案（縮排對齊狀態圖示） -->
                <TextBlock
                    x:Name="FileText"
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />

                <!-- 進度條 + 百分比（同一列，IDM 式） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        x:Name="ProgressBar"
                        Height="6"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="PercentText"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="0%" />
                </Grid>

                <!-- 狀態行 / 錯誤訊息 -->
                <TextBlock
                    x:Name="StateText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="ErrorText"
                    Visibility="Collapsed"
                    FontSize="12.5"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="WrapWholeWords" />

                <!-- 動作按鈕（右下） -->
                <StackPanel
                    x:Name="ActionButtons"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="OpenFolderButton"
                        Content=""
                        Padding="12,5"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="CancelButton"
                        Content=""
                        Padding="12,5" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- Full-window visual splitter, shown while the user builds the split spec. -->
    <local:SplitPagesOverlay x:Name="SplitOverlay" Visibility="Collapsed"/>
    </Grid>
</Page>
