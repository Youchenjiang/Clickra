<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clickra_Fluent.TaskProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clickra_Fluent">
    <Grid>
    <ScrollViewer
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,16">
            <Grid
                x:Name="LayoutRoot"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                RowSpacing="12"
                SizeChanged="OnLayoutSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <FontIcon
                            x:Name="StatusIcon"
                            Glyph="&#xE895;"
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleText"
                            Text=""
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="FileText"
                            Text=""
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="StateText"
                            Text=""
                            FontSize="14"
                            TextWrapping="WrapWholeWords" />
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="ProgressBar"
                                Height="4"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="PercentText"
                                Grid.Column="1"
                                MinWidth="42"
                                Text="0%"
                                TextAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock
                            x:Name="OutputText"
                            Grid.Row="2"
                            Text=""
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="ErrorText"
                            Grid.Row="3"
                            Visibility="Collapsed"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>

                <Grid
                    x:Name="ActionLayout"
                    Grid.Row="2"
                    ColumnSpacing="12"
                    RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ActionButtonsRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="FooterText"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text=""
                        TextWrapping="WrapWholeWords" />
                    <StackPanel
                        x:Name="ActionButtons"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            x:Name="OpenFolderButton"
                            Content=""
                            Padding="12,6"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="CancelButton"
                            Content=""
                            Padding="14,6" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>

    <!-- Full-window visual splitter, shown while the user builds the split spec. -->
    <local:SplitPagesOverlay x:Name="SplitOverlay" Visibility="Collapsed"/>
    </Grid>
</Page>
