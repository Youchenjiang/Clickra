<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>../../app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.0.0</Version>
    <Authors>Youchen Jiang</Authors>
    <Description>Instant Windows Context Menu Utility Suite</Description>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\resources\AppxManifest.xml" Link="Resources\AppxManifest.xml" />
    <EmbeddedResource Include="..\resources\app.png" Link="Resources\app.png" />
    <EmbeddedResource Include="..\..\ContextToolsShell.dll" Link="Resources\ContextToolsShell.dll" />
  </ItemGroup>

</Project>
