<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net8.0'">WinExe</OutputType>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('windows'))">net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('windows'))">../../obj/icons/app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Youchen Jiang</Authors>
    <Description>Instant Windows Context Menu Utility Suite</Description>
    <DebugType>none</DebugType>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Clickra</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../publish/nupkg</PackageOutputPath>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Youchenjiang/Clickra</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Youchenjiang/Clickra</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clickra</ToolCommandName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Core" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Fonts" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Package" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Tokenization" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig.Tokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clickra.Core\Clickra.Core.csproj" />
  </ItemGroup>

  <Target Name="IncludeGeneratedIcons" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems" DependsOnTargets="EnsureClickraIcons" Condition="$([MSBuild]::IsOSPlatform('windows'))">
    <ItemGroup>
      <Content Include="..\..\obj\icons\menu-*.ico">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
      <Content Include="..\..\obj\icons\app.ico">
        <Link>app.ico</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>
