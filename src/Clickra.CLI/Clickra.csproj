<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>../resources/app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Youchen Jiang</Authors>
    <Description>Instant Windows Context Menu Utility Suite</Description>
    <DebugType>none</DebugType>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\resources\AppxManifest.xml" Link="Resources\AppxManifest.xml" />
    <EmbeddedResource Include="..\resources\app.png" Link="Resources\app.png" />
    <EmbeddedResource Include="..\resources\Clickra.exe.manifest" Link="Resources\Clickra.exe.manifest" />
    <EmbeddedResource Include="..\resources\ClickraShell.dll.manifest" Link="Resources\ClickraShell.dll.manifest" />
    <EmbeddedResource Include="..\..\ClickraShell.dll" Link="Resources\ClickraShell.dll" />
  </ItemGroup>

</Project>
